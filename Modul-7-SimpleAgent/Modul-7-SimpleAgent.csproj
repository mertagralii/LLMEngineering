<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Modul_7_SimpleAgent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.48.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="OllamaSharp" Version="5.4.30" />
  </ItemGroup>

  <ItemGroup>
    <None Update="docs\*.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="prompts\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="homeworkPrompts\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
