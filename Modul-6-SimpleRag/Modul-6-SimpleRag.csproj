<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Modul_6_SimpleRag</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.48.0" />
    <PackageReference Include="OllamaSharp" Version="5.4.30" />
  </ItemGroup>

  <ItemGroup>
    <None Update="docs\*.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="prompts\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="homeworkdocs\*.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="homeworkprompts\Readmerag.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
